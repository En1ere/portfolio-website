{
  "name": "portfolio-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:styles": "stylelint \"src/**/*.{css,scss,vue}\"",
    "lint:styles:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix",
    "format": "prettier . --write",
    "check": "npm run lint && npm run lint:styles && npm run build",
    "i18n:pull": "tsx scripts/googlesheets-translate.ts",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.6.2",
    "google-spreadsheet": "^5.2.0",
    "swiper": "^12.2.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.4",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.25.0",
    "eslint-plugin-vue": "^10.0.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "sass": "^1.100.0",
    "stylelint": "^16.16.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "tsx": "^4.22.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.2.4",
    "vue-tsc": "^2.2.8"
  }
}
